exports[`yaml > generates the base module 1`] = `
"declare const config: {
	readonly name: string;
	readonly port: number;
	readonly host: string;
	readonly url: string;
	readonly debug: boolean;
	readonly ratio: number;
	readonly nothing: null;
	readonly db: {
		readonly url: string;
		readonly pool: {
			readonly min: number;
			readonly max: number;
		};
	};
	readonly tags: readonly string[];
	readonly mixed: readonly (number | string | boolean | null | {
		readonly a: number;
	} | {
		readonly b: number;
	} | readonly number[])[];
	readonly plugins: readonly unknown[];
	readonly extra: {};
};
export default config;
"
`;

exports[`yaml > generates the environment module 1`] = `
"import type Base from "./app.config.yaml";

type Config = typeof Base;
type Override<T> = T extends readonly unknown[]
	? T
	: T extends object
		? [keyof T] extends [never]
			? { readonly [key: string]: never }
			: { readonly [K in keyof T]?: Override<T[K]> }
		: T;
type At<T, K> = T extends object ? (K extends keyof T ? T[K] : any) : any;

({ port: (undefined as never) }) satisfies Override<Config>;
({ debug: "yes" }) satisfies Override<Config>;
({ unknown: 1 }) satisfies Override<Config>;
({ db: {} }) satisfies Override<Config>;
({ pool: {} }) satisfies Override<At<Config, "db">>;
({ min: "1" }) satisfies Override<At<At<Config, "db">, "pool">>;
({ oops: 2 }) satisfies Override<At<At<Config, "db">, "pool">>;
({ url: "x" }) satisfies Override<At<Config, "db">>;
({ tags: [1, "x"] }) satisfies Override<Config>;

declare const config: Config;
export default config;
"
`;
