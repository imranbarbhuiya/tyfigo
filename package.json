{
	"name": "tyfigo",
	"version": "0.0.0",
	"description": "Import YAML, TOML, JSON5, INI and .env files into TypeScript with full type inference",
	"keywords": [
		"config",
		"content-mapper",
		"dotenv",
		"effect",
		"ini",
		"json5",
		"toml",
		"typescript",
		"yaml"
	],
	"homepage": "https://github.com/imranbarbhuiya/tyfigo#readme",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/tyfigo/issues"
	},
	"license": "MIT",
	"author": "Parbez <imranbarbhuiya.fsd@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/tyfigo.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./effect": {
			"types": "./dist/effect.d.mts",
			"import": "./dist/effect.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.mts",
			"import": "./dist/runtime/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"update": "bun update --interactive",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "bun run build",
		"prepare": "husky .github/husky && effect-tsgo patch --typescript --oxlint"
	},
	"dependencies": {
		"effect": "^4.0.6",
		"jsonc-eslint-parser": "^3.3.0",
		"jsonc-parser": "^3.3.1",
		"toml-eslint-parser": "^1.0.3",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@effect/tsgo": "^0.59.0",
		"@effect/vitest": "^4.0.6",
		"@favware/cliff-jumper": "^6.1.0",
		"@imranbarbhuiya/oxc-config": "^0.4.1",
		"@types/node": "^26.6.5",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.75.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"tsdown": "^0.23.2",
		"typescript": "7.1.0-beta",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,mjs,cjs,ts,mts,cts}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.4"
}
