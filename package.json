{
	"name": "tyfigo",
	"version": "0.0.0",
	"description": "Import YAML, TOML, JSON5, INI and .env files into TypeScript with full type inference",
	"keywords": [
		"config",
		"content-mapper",
		"dotenv",
		"effect",
		"ini",
		"json5",
		"toml",
		"typescript",
		"yaml"
	],
	"homepage": "https://tyfigo.vercel.app",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/tyfigo/issues"
	},
	"license": "MIT",
	"author": "Parbez <imranbarbhuiya.fsd@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/tyfigo.git"
	},
	"workspaces": [
		"examples/*",
		"site"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"./dist/register.mjs",
		"./dist/bun.mjs"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"browser": "./dist/index.browser.mjs",
			"default": "./dist/index.mjs"
		},
		"./effect": {
			"types": "./dist/effect.d.mts",
			"browser": "./dist/effect.browser.mjs",
			"default": "./dist/effect.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.mts",
			"default": "./dist/runtime/index.mjs"
		},
		"./register": {
			"types": "./dist/register.d.mts",
			"default": "./dist/register.mjs"
		},
		"./bun": {
			"types": "./dist/bun.d.mts",
			"default": "./dist/bun.mjs"
		},
		"./vite": {
			"types": "./dist/plugins/vite.d.mts",
			"default": "./dist/plugins/vite.mjs"
		},
		"./rollup": {
			"types": "./dist/plugins/rollup.d.mts",
			"default": "./dist/plugins/rollup.mjs"
		},
		"./rolldown": {
			"types": "./dist/plugins/rolldown.d.mts",
			"default": "./dist/plugins/rolldown.mjs"
		},
		"./esbuild": {
			"types": "./dist/plugins/esbuild.d.mts",
			"default": "./dist/plugins/esbuild.mjs"
		},
		"./webpack": {
			"types": "./dist/plugins/webpack.d.mts",
			"default": "./dist/plugins/webpack.mjs"
		},
		"./rspack": {
			"types": "./dist/plugins/rspack.d.mts",
			"default": "./dist/plugins/rspack.mjs"
		},
		"./rsbuild": {
			"types": "./dist/plugins/rsbuild.d.mts",
			"default": "./dist/plugins/rsbuild.mjs"
		},
		"./next": {
			"types": "./dist/plugins/next.d.mts",
			"default": "./dist/plugins/next.mjs"
		},
		"./jest": {
			"types": "./dist/plugins/jest.d.mts",
			"default": "./dist/plugins/jest.mjs"
		},
		"./loader": {
			"types": "./dist/plugins/loader.d.mts",
			"default": "./dist/plugins/loader.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"update": "bun update --interactive",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "bun run build",
		"prepare": "husky .github/husky && effect-tsgo patch --typescript --oxlint"
	},
	"dependencies": {
		"@rgrove/parse-xml": "^5.0.0",
		"@standard-schema/spec": "^1.1.0",
		"effect": "^4.0.7",
		"jsonc-eslint-parser": "^3.3.0",
		"jsonc-parser": "^3.3.1",
		"toml-eslint-parser": "^1.0.3",
		"unplugin": "^3.7.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@effect/tsgo": "^0.59.0",
		"@effect/vitest": "^4.0.7",
		"@favware/cliff-jumper": "^6.1.0",
		"@imranbarbhuiya/oxc-config": "^0.4.1",
		"@jest/transform": "^30.5.2",
		"@rsbuild/core": "^2.2.14",
		"@rspack/core": "^2.2.9",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"arktype": "^2.2.9",
		"cz-conventional-changelog": "^3.3.0",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"next": "^16.4.3",
		"oxfmt": "^0.75.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rolldown": "^1.2.15",
		"rollup": "^4.66.0",
		"tsdown": "^0.23.2",
		"tsup": "^9.0.0",
		"typescript": "7.1.0-beta",
		"valibot": "^1.5.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"webpack": "^5.112.2",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@rsbuild/core": ">=1.0.0",
		"@rspack/core": ">=1.0.0",
		"esbuild": ">=0.25.0",
		"jest": ">=29.0.0",
		"next": ">=16.0.0",
		"rolldown": ">=1.0.0",
		"rollup": ">=4.0.0",
		"vite": ">=6.0.0",
		"webpack": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@rsbuild/core": {
			"optional": true
		},
		"@rspack/core": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"jest": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"rolldown": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,mjs,cjs,ts,mts,cts}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"typescript": {
		"contentMapper": {
			"compilerOptions": [],
			"exec": [
				"node",
				"dist/mapper.mjs"
			]
		}
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.4"
}
