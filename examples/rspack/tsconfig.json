{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"contentMappers": [
		{
			"package": "tyfigo",
			"extensions": [".config.yaml", ".config.yml", ".config.toml", ".config.jsonc", ".config.json5"]
		}
	],
	"include": ["src", "config", "*.ts"]
}
