{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["dom", "dom.iterable", "es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"contentMappers": [
		{
			"package": "tyfigo",
			"extensions": [
				".config.yaml",
				".config.yml",
				".config.toml",
				".config.jsonc",
				".config.json5",
				".config.ini",
				".config.properties",
				".config.xml"
			]
		}
	],
	"include": ["src", "*.ts", "site.config.yaml"]
}
